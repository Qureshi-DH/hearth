{
  "name": "hearth-mobile",
  "version": "1.2.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "main": "index.tsx",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "bundle:web": "npx expo export --platform web",
    "serve:web": "npx serve dist",
    "compile": "tsc --noEmit -p . --pretty",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "depcruise": "depcruise app --config .dependency-cruiser.js",
    "depcruise:graph": "depcruise app --include-only \"^app\" --config .dependency-cruiser.js --output-type dot > app-dependency-graph.dot && dot -T svg app-dependency-graph.dot -o app-dependency-graph.svg && dot -T png app-dependency-graph.dot -o app-dependency-graph.png && rm app-dependency-graph.dot",
    "align-deps": "npx expo install --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "adb": "adb reverse tcp:9090 tcp:9090 && adb reverse tcp:3000 tcp:3000 && adb reverse tcp:9001 tcp:9001 && adb reverse tcp:8081 tcp:8081",
    "typecheck": "tsc --noEmit -p . --pretty",
    "build:android:dev": "./scripts/eas-build.sh --profile development --platform android --local",
    "build:android:prod": "./scripts/eas-build.sh --profile production --platform android --local",
    "build:android:prod:apk": "./scripts/eas-build.sh --profile production:apk --platform android --local",
    "build:ios:sim": "./scripts/eas-build.sh --profile development --platform ios --local",
    "build:ios:dev": "./scripts/eas-build.sh --profile development:device --platform ios --local",
    "build:ios:prod": "./scripts/eas-build.sh --profile production --platform ios --local",
    "prebuild:clean": "npx expo prebuild --clean"
  },
  "dependencies": {
    "@expo-google-fonts/space-grotesk": "^0.4.0",
    "@expo/metro-runtime": "~55.0.6",
    "@expo/vector-icons": "^15.1.1",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@hearth/shared": "workspace:*",
    "@maplibre/maplibre-react-native": "^11.3.9",
    "@react-navigation/bottom-tabs": "^7.2.0",
    "@react-navigation/native": "^7.0.14",
    "@react-navigation/native-stack": "^7.2.0",
    "@tanstack/react-query": "^5.102.8",
    "@types/geojson": "^7946.0.16",
    "expo": "55.0.31",
    "expo-application": "~55.0.8",
    "expo-background-task": "~55.0.22",
    "expo-battery": "~55.0.17",
    "expo-blur": "~55.0.18",
    "expo-build-properties": "~55.0.9",
    "expo-camera": "~55.0.23",
    "expo-clipboard": "~55.0.17",
    "expo-constants": "~55.0.17",
    "expo-dev-client": "~55.0.11",
    "expo-device": "~55.0.21",
    "expo-file-system": "~55.0.26",
    "expo-font": "~55.0.4",
    "expo-haptics": "~55.0.18",
    "expo-image": "~55.0.11",
    "expo-image-manipulator": "~55.0.21",
    "expo-image-picker": "~55.0.24",
    "expo-intent-launcher": "~55.0.16",
    "expo-keep-awake": "~55.0.8",
    "expo-linear-gradient": "~55.0.18",
    "expo-linking": "~55.0.7",
    "expo-localization": "~55.0.8",
    "expo-location": "~55.1.14",
    "expo-notifications": "~55.0.27",
    "expo-secure-store": "~55.0.18",
    "expo-sensors": "~55.0.19",
    "expo-sharing": "~55.0.24",
    "expo-splash-screen": "~55.0.10",
    "expo-system-ui": "~55.0.9",
    "expo-task-manager": "~55.0.20",
    "i18next": "^23.14.0",
    "intl-pluralrules": "^2.0.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-i18next": "^15.0.1",
    "react-native": "0.83.10",
    "react-native-edge-to-edge": "~1.6.1",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-keyboard-controller": "1.20.7",
    "react-native-mmkv": "3.3.3",
    "react-native-qrcode-svg": "^6.3.22",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.7.4",
    "setimmediate": "^1.0.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@babel/preset-env": "^7.20.0",
    "@babel/runtime": "^7.20.0",
    "@testing-library/react-native": "^13.2.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.10",
    "babel-jest": "^29.2.1",
    "dependency-cruiser": "^18.4.0",
    "eslint-config-expo": "~55.0.0",
    "jest": "~29.7.0",
    "jest-expo": "~55.0.9",
    "prettier": "^3.9.9",
    "react-test-renderer": "19.2.0",
    "reactotron-core-client": "^2.9.4",
    "reactotron-react-js": "^3.3.11",
    "reactotron-react-native": "^5.0.5",
    "reactotron-react-native-mmkv": "^0.2.6",
    "ts-jest": "^29.4.14",
    "tsx": "^4.23.15",
    "typescript": "~5.9.2"
  },
  "engines": {
    "node": ">=20.19.4"
  },
  "expo": {
    "autolinking": {
      "android": {
        "buildFromSource": [
          "expo-location",
          "expo-notifications"
        ]
      }
    }
  }
}
