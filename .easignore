# EAS reads this file instead of every .gitignore when it copies the working
# tree into the build directory. It mirrors them with one difference: the
# Firebase client config (google-services.json, GoogleService-Info.plist) is
# not listed, because the build compiles it in and a gitignore-driven copy
# would leave it out without saying so. Push would then fail on every phone.

node_modules/
dist/
build/
coverage/
.turbo/
.claude/

# env / secrets
.env
.env.*
!.env.example
*.pem
*.key
*.jks
*.keystore
!debug.keystore
*.p8
*.p12
*.mobileprovision
*service-account*.json
*firebase-adminsdk*.json

# runtime data
data/
postgres-data/
*.log

# OS / editors
.DS_Store
.idea/
.vscode/
*.swp

# expo / native, regenerated by prebuild inside the build directory
apps/mobile/.expo/
apps/mobile/android/
apps/mobile/ios/
apps/mobile/expo-env.d.ts
apps/mobile/dist/
apps/mobile/web-build/
apps/mobile/app-dependency-graph.*
apps/mobile/.gradle/
apps/mobile/*.jsbundle

# docs site output
docs/build/
docs/.docusaurus/

# artifacts earlier local builds dropped into the project
build-*.apk
build-*.aab
build-*.ipa
