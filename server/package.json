{
  "name": "@hearth/server",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "description": "Hearth API server. Self-hosted family location sharing.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../.env --env-file-if-exists=.env --clear-screen=false src/index.ts",
    "build": "tsup",
    "start": "node --env-file-if-exists=../.env --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=../.env --env-file-if-exists=.env src/db/migrate-cli.ts",
    "db:studio": "drizzle-kit studio",
    "seed": "tsx --env-file-if-exists=../.env --env-file-if-exists=.env src/db/seed.ts",
    "lint": "eslint src --max-warnings 0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1127.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/jwt": "^10.2.2",
    "@fastify/multipart": "^10.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@fastify/websocket": "^11.3.0",
    "@hearth/shared": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.3",
    "fastify-plugin": "^5.1.0",
    "fastify-type-provider-zod": "^7.0.0",
    "ioredis": "^6.0.0",
    "postgres": "^3.4.9",
    "web-push": "^3.6.7",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^0.31.10",
    "pino-pretty": "^13.1.3",
    "tsup": "^8.5.1",
    "tsx": "^4.23.13",
    "typescript": "5.9.3",
    "vitest": "^5.0.0"
  }
}
