# ============================================================================
#  Hearth server configuration
#  Copy to `.env` and edit. JWT_SECRET, PUBLIC_URL, POSTGRES_PASSWORD,
#  S3_SECRET_ACCESS_KEY, ADMIN_EMAIL and ADMIN_PASSWORD have to be set for a
#  real deployment. Everything else has a sensible default.
# ============================================================================

# --- Required ----------------------------------------------------------------

# 48+ random bytes. Generate with:  openssl rand -base64 48
JWT_SECRET=

# The URL phones will use to reach this server (through your reverse proxy).
PUBLIC_URL=https://hearth.example.com

# --- Database (docker-compose wires DATABASE_URL from these) -------------------
POSTGRES_USER=hearth
# Generate with:  openssl rand -hex 24
# Hex, because the password goes into a connection URL and base64 can contain
# a "/" that breaks it. Blank is not allowed: compose stops with
# "set POSTGRES_PASSWORD in .env" rather than falling back to a default every
# deployment would share.
POSTGRES_PASSWORD=
POSTGRES_DB=hearth
# Only needed when NOT using docker-compose:
# DATABASE_URL=postgres://hearth:hearth@localhost:5432/hearth

# --- Server ------------------------------------------------------------------
# "::" listens on IPv6 and IPv4. Clients that resolve localhost to ::1 need that.
HOST=::
# Only needed when NOT using docker-compose, which pins this to 4000:
# PORT=4000
SERVER_NAME=Hearth
# open    - anyone who can reach the server may sign up
# invite  - sign-up requires an invite code from an existing circle (default)
# closed  - no self-service sign-up at all
REGISTRATION_MODE=invite
# Turn on ONLY once a reverse proxy terminates TLS in front of Hearth.
# While it is on, X-Forwarded-For is trusted, so a direct client could forge
# its own IP and slip the per-IP rate limit.
TRUST_PROXY=false
# Comma-separated browser origins. Leave empty for phone-only deployments.
CORS_ORIGINS=
LOG_LEVEL=info

# Required in production. Creates the one account that exists on first boot,
# while the database still has no users. On the default invite-only
# registration this is the only way into a new server, and on open
# registration it stops the first stranger to sign up becoming the admin.
# Changing these later does nothing. Change the password from the app.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Optional. Defaults to the part of ADMIN_EMAIL before the @.
ADMIN_NAME=

# --- Docker Compose only ------------------------------------------------------
# Host port published in front of the container. The API inside always
# listens on 4000, which the healthcheck and the port mapping both assume.
HEARTH_PORT=4000
# The address that port is published on. Loopback, so only a reverse proxy on
# this machine reaches the API. Docker's port rules go around ufw and
# firewalld, so a port on every interface is open to whoever can reach the
# machine, whatever the firewall says. 0.0.0.0 lets phones on the LAN connect
# straight to it, as the quick start does. Never on a machine the internet
# can reach.
HEARTH_BIND=127.0.0.1

# --- Object storage (profile pictures) --------------------------------------
# The compose stack runs MinIO. Any S3 compatible storage works: point
# S3_ENDPOINT at it and set the keys. Leave S3_ENDPOINT empty and uploads are
# switched off, with avatars falling back to initials on a colour.
S3_BUCKET=hearth
S3_ACCESS_KEY_ID=hearth
# MinIO ignores the region and needs path style addressing. Most hosted S3
# compatible services want a real region and virtual host style instead.
# S3_REGION=us-east-1
# S3_FORCE_PATH_STYLE=true
# Doubles as the MinIO root password in the compose stack, where compose
# refuses to start if it is blank. Generate with:
#   openssl rand -hex 24
S3_SECRET_ACCESS_KEY=
# Where MinIO keeps the pictures. A named Docker volume unless this points at a
# host directory, and then a backup has to copy that directory instead of the
# volume the backup instructions name.
# MINIO_DATA_PATH=/srv/hearth/minio

# --- Push notifications (see docs/docs/install/push-notifications.md) ---------------------
# none    - no push, so the app polls and uses a websocket while open (default)
# expo    - Expo's hosted push relay, the only one that can wake the app. Needs
#           an app built with your own Expo, Firebase and Apple keys
# ntfy    - self-hosted ntfy, alerts only, shown by the ntfy app
# webpush - VAPID Web Push, for a future web client. The app doesn't use it
PUSH_PROVIDER=none

# expo
EXPO_ACCESS_TOKEN=

# ntfy
NTFY_BASE_URL=
NTFY_TOKEN=
NTFY_TOPIC_PREFIX=hearth
# When ntfy runs in the same compose network, the api can reach it internally:
NTFY_INTERNAL_URL=

# webpush. Generate with:  npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# --- Maps --------------------------------------------------------------------
# Any MapLibre style JSON. Default is OpenFreeMap (no API key, no tracking).
# Self-host tiles with e.g. Martin/TileServer GL and point both URLs at your
# styles. The dark one is what the app loads whenever the phone is in dark mode,
# so setting only the light one leaves those tiles coming from openfreemap.org.
MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
MAP_STYLE_URL_DARK=https://tiles.openfreemap.org/styles/dark
MAP_ATTRIBUTION=© OpenStreetMap contributors

# --- Data retention & tuning -------------------------------------------------
# Hard cap on breadcrumb history, regardless of per-circle settings.
MAX_HISTORY_RETENTION_DAYS=90
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=60
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW=1 minute
JOB_INTERVAL_SECONDS=60
ENABLE_SWAGGER=true

# --- Optional: multi-instance realtime ---------------------------------------
# REDIS_URL=redis://redis:6379
