# Copy to hearth.env. kustomize turns it into the "hearth" Secret, and the API
# reads every key in it. .env.example at the repository root describes the rest.

# openssl rand -hex 48
JWT_SECRET=
# The https address the Ingress serves, as phones will type it.
PUBLIC_URL=https://hearth.example.com
ADMIN_EMAIL=
# At least 10 characters. Only read on the first start.
ADMIN_PASSWORD=
# openssl rand -hex 24. Hex, because it goes into a connection URL.
POSTGRES_PASSWORD=

REGISTRATION_MODE=invite
PUSH_PROVIDER=none
